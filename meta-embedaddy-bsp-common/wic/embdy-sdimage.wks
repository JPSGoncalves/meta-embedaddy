# short-description: Embedaddy disk image - FAT boot partition + ext4 rootfs
#
# Distro-side layout only. On a real SoC the BSP layer's .wks prepends
# everything that runs before Linux.
bootloader --ptable=gpt

part /boot --part-name=bootfs --size=64M  --use-uuid --fstype=vfat --label=boot --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/boot --active
part /     --part-name=root --size=256M --use-uuid --fstype=ext4 --label=root --source rootfs --exclude-path=boot/
