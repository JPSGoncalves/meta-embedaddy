# short-description: MilkV DuoS SD card image

bootloader  --ptable msdos

part /boot --fixed-size=128M  --align 1024 --use-uuid --fstype=vfat --label=boot --source bootimg-partition --active --ondisk=mmcblk0
part /     --size=256M        --align 1024            --fstype=ext4 --label=root --source=rootfs                     --ondisk=mmcblk0
