# fw_printenv/fw_setenv: U-Boot environment in the GPT partition "u-boot-env".
# Two entries = redundant environment. Offset/size mirror ST's fw_env.config.mmc
# and must match CONFIG_ENV_SIZE / CONFIG_ENV_OFFSET_REDUND of stm32mp15_defconfig.
/dev/disk/by-partlabel/u-boot-env	-0x2000	0x2000
/dev/disk/by-partlabel/u-boot-env	-0x2000	0x2000
